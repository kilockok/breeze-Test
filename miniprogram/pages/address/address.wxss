.container {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx 4% calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* Address Card */
.address-card {
  background: var(--color-card);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(100, 70, 30, 0.06);
  animation: fadeInUp 0.35s ease-out;
  transition: transform 0.2s ease;
}

.address-card:active {
  transform: scale(0.98);
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.user-info {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-text);
}

.user-phone {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--color-text);
}

.default-tag {
  font-size: 22rpx;
  color: #FFFFFF;
  background: var(--color-primary);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  line-height: 1.6;
  flex-shrink: 0;
}

.address-detail {
  font-size: 26rpx;
  color: #666666;
  margin-top: 14rpx;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* Card Actions */
.card-actions {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #EEEEEE;
  flex-wrap: wrap;
  gap: 8rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999999;
  margin-right: 32rpx;
  transition: color 0.2s;
}

.action-btn:active {
  color: var(--color-primary);
}

.action-btn text {
  font-size: 24rpx;
  color: inherit;
}

.icon-edit,
.icon-delete {
  margin-right: 6rpx;
  font-size: 26rpx;
}

.action-default {
  margin-left: auto;
  margin-right: 0;
}

.radio-circle {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #CCCCCC;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
  transition: border-color 0.2s;
}

.radio-active {
  border-color: var(--color-primary);
}

.radio-inner {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--color-primary);
  animation: scaleIn 0.25s ease-out;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  animation: fadeIn 0.5s ease-out;
}

.empty-state .ic {
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 40rpx;
}

.empty-add-btn {
  font-size: 28rpx;
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
  border-radius: 40rpx;
  padding: 16rpx 60rpx;
  transition: transform 0.2s ease;
}

.empty-add-btn:active {
  transform: scale(0.95);
}

/* Bottom Bar */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 6%;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-card);
  box-shadow: 0 -2rpx 10rpx rgba(100, 70, 30, 0.06);
  animation: slideUp 0.3s ease-out;
}

.add-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  border-radius: 44rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 20rpx rgba(232, 145, 58, 0.3);
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.add-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}
