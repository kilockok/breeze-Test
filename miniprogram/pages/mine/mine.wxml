<view class="page">
  <!-- Profile Header -->
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-content">
      <!-- Not logged in: choose avatar + nickname -->
      <block wx:if="{{!isLoggedIn}}">
        <view class="login-form">
          <view class="avatar-pick-wrap">
            <button class="avatar-pick-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
              <image wx:if="{{tempAvatarUrl}}" class="avatar-preview" src="{{tempAvatarUrl}}" mode="aspectFill" />
              <view wx:else class="avatar-placeholder">
                <view class="ic ic-lg ic-camera ic--white"></view>
                <text class="avatar-placeholder-text">选择头像</text>
              </view>
            </button>
          </view>
          <view class="nickname-input-wrap">
            <input class="nickname-input" type="nickname" placeholder="请输入昵称" placeholder-style="color:rgba(255,255,255,0.5);" bindinput="onNicknameInput" bindblur="onNicknameInput" value="{{tempNickname}}" />
          </view>
          <view class="login-action-wrap">
            <button class="login-action-btn" bindtap="confirmLogin">确认登录</button>
          </view>
        </view>
      </block>
      <!-- Logged in -->
      <block wx:else>
        <view class="avatar-wrap">
          <image wx:if="{{userInfo.avatarUrl}}" class="avatar-img" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
          <view wx:else class="avatar-default">
            <view class="ic ic-xl ic-avatar ic--white"></view>
          </view>
        </view>
        <view class="user-text">
          <text class="nickname">{{userInfo.nickName || userInfo.nick_name || '微信用户'}}</text>
          <text class="phone" wx:if="{{userInfo.phone}}">{{userInfo.phone}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- Orders Section -->
  <view class="card order-card">
    <view class="card-header">
      <text class="card-title">我的订单</text>
      <view class="card-link" bindtap="goOrders" data-tab="all">
        <text>查看全部</text>
        <text class="arrow">></text>
      </view>
    </view>
    <view class="order-entries">
      <view class="order-entry" bindtap="goOrders" data-tab="pending">
        <view class="entry-icon-wrap">
          <view class="ic ic-lg ic-pending ic--primary"></view>
          <view class="badge" wx:if="{{pendingCount > 0}}">
            <text>{{pendingCount > 99 ? '99+' : pendingCount}}</text>
          </view>
        </view>
        <text class="entry-label">待支付</text>
      </view>
      <view class="order-entry" bindtap="goOrders" data-tab="making">
        <view class="entry-icon-wrap">
          <view class="ic ic-lg ic-making ic--blue"></view>
          <view class="badge" wx:if="{{makingCount > 0}}">
            <text>{{makingCount > 99 ? '99+' : makingCount}}</text>
          </view>
        </view>
        <text class="entry-label">制作中</text>
      </view>
      <view class="order-entry" bindtap="goOrders" data-tab="completed">
        <view class="entry-icon-wrap">
          <view class="ic ic-lg ic-done ic--success"></view>
        </view>
        <text class="entry-label">已完成</text>
      </view>
    </view>
  </view>

  <!-- Menu List -->
  <view class="card menu-card">
    <view class="menu-item" bindtap="goAddress">
      <view class="menu-left">
        <view class="ic ic-md ic-location ic--primary menu-icon-view"></view>
        <text class="menu-text">收货地址管理</text>
      </view>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goProfile">
      <view class="menu-left">
        <view class="ic ic-md ic-user ic--primary menu-icon-view"></view>
        <text class="menu-text">个人信息</text>
      </view>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="contactService">
      <view class="menu-left">
        <view class="ic ic-md ic-phone ic--primary menu-icon-view"></view>
        <text class="menu-text">联系客服</text>
      </view>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goAbout">
      <view class="menu-left">
        <view class="ic ic-md ic-info ic--primary menu-icon-view"></view>
        <text class="menu-text">关于我们</text>
      </view>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <!-- Logout -->
  <view class="logout-wrap" wx:if="{{isLoggedIn}}">
    <button class="btn-logout" bindtap="logout">退出登录</button>
  </view>
</view>
