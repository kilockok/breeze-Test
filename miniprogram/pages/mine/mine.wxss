.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
}

/* ========== Header ========== */
.header {
  position: relative;
  min-height: 320rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  border-radius: 0 0 60rpx 60rpx;
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 0 6%;
  padding-top: calc(env(safe-area-inset-top) + 80rpx);
  padding-bottom: 48rpx;
  animation: fadeIn 0.5s ease-out;
}

/* ========== Login Form ========== */
.login-form {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 20rpx 0;
}

.avatar-pick-wrap {
  margin-bottom: 28rpx;
}

.avatar-pick-btn {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  background: rgba(255, 255, 255, 0.2);
  border: 4rpx dashed rgba(255, 255, 255, 0.6);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  transition: transform 0.3s ease;
}

.avatar-pick-btn:active {
  transform: scale(0.92);
}

.avatar-pick-btn::after {
  border: none;
}

.avatar-preview {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.avatar-placeholder-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
}

.nickname-input-wrap {
  width: 75%;
  margin-bottom: 28rpx;
}

.nickname-input {
  height: 76rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 38rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #fff;
  text-align: center;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.login-action-wrap {
  width: 75%;
}

.login-action-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-primary);
  background: #fff;
  border-radius: 40rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.2s ease;
}

.login-action-btn:active {
  transform: scale(0.96);
}

.login-action-btn::after {
  border: none;
}

/* ========== Logged In Avatar ========== */
.avatar-wrap {
  flex-shrink: 0;
  margin-right: 28rpx;
}

.avatar-default {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid rgba(255, 255, 255, 0.5);
  transition: transform 0.3s ease;
}

.avatar-default:active {
  transform: scale(0.92);
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  transition: transform 0.3s ease;
}

.avatar-img:active {
  transform: scale(0.92);
}

.user-text {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.phone {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}

/* ========== Cards ========== */
.card {
  margin: 24rpx 4% 0;
  background: var(--color-card);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(100, 70, 30, 0.06);
}

/* ========== Order Card ========== */
.order-card {
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
  animation: fadeInUp 0.4s ease-out;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.card-link {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  transition: color 0.2s;
}

.card-link:active {
  color: var(--color-primary);
}

.card-link .arrow {
  font-size: 28rpx;
  margin-left: 4rpx;
  color: #ccc;
}

.order-entries {
  display: flex;
  padding: 32rpx 0 28rpx;
}

.order-entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.2s ease;
}

.order-entry:active {
  transform: scale(0.92);
}

.entry-icon-wrap {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: var(--color-danger);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: bounceIn 0.4s ease-out;
}

.badge text {
  font-size: 20rpx;
  color: #fff;
  font-weight: 500;
  line-height: 1;
}

.entry-label {
  font-size: 24rpx;
  color: #666;
  margin-top: 12rpx;
}

/* ========== Menu Card ========== */
.menu-card {
  margin-top: 24rpx;
  animation: fadeInUp 0.5s ease-out;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid var(--color-border);
  transition: background 0.2s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #FAFAF8;
}

.menu-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.menu-icon-view {
  margin-right: 20rpx;
  flex-shrink: 0;
}

.menu-text {
  font-size: 28rpx;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
  font-weight: 300;
  flex-shrink: 0;
}

/* ========== Logout ========== */
.logout-wrap {
  padding: 60rpx 6% 40rpx;
  animation: fadeInUp 0.6s ease-out;
}

.btn-logout {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  background: var(--color-card);
  border: 1rpx solid #ddd;
  border-radius: 44rpx;
  transition: transform 0.2s ease, background 0.2s ease;
}

.btn-logout::after {
  border: none;
}

.btn-logout:active {
  background: var(--color-bg);
  transform: scale(0.98);
}
