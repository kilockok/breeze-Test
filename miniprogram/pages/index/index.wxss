/**index.wxss**/

page {
  height: 100vh;
  background: #F5F5F5;
}

.page {
  min-height: 100vh;
  background: #F5F5F5;
}

/* ========== 自定义导航栏 ========== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: linear-gradient(135deg, #F5A623, #FF8C42);
}

.nav-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4%;
}

.nav-location {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.nav-location-icon {
  font-size: 28rpx;
  margin-right: 6rpx;
  flex-shrink: 0;
}

.nav-location-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
  max-width: 40vw;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-arrow {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 4rpx;
  flex-shrink: 0;
}

.nav-brand {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  flex-shrink: 0;
}

.nav-placeholder {
  flex: 1;
}

/* ========== 滚动区域 ========== */
.scroll-area {
  flex: 1;
  height: 100vh;
}

/* ========== 问候区域 ========== */
.greeting-section {
  padding: 32rpx 5% 8rpx;
  animation: fadeInUp 0.4s ease-out;
}

.greeting-row {
  display: flex;
  align-items: center;
}

.greeting-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.4;
}

.greeting-sub {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

/* ========== Banner 轮播 ========== */
.banner-section {
  padding: 24rpx 4% 0;
  animation: fadeInUp 0.5s ease-out;
}

.banner-swiper {
  height: 42vw;
  min-height: 260rpx;
  max-height: 360rpx;
  border-radius: 24rpx;
  overflow: visible;
}

.banner-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: calc(42vw - 40rpx);
  min-height: 220rpx;
  max-height: 320rpx;
  margin: 0 4rpx;
  border-radius: 24rpx;
  padding: 5%;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(245, 166, 35, 0.25);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.banner-card-0 {
  background: linear-gradient(135deg, #FF9A9E, #FECFEF);
}

.banner-card-1 {
  background: linear-gradient(135deg, #F5A623, #FF8C42);
}

.banner-card-2 {
  background: linear-gradient(135deg, #A8E063, #56AB2F);
}

.banner-content {
  flex: 1;
  z-index: 1;
  min-width: 0;
}

.banner-tag {
  display: inline-block;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.3);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  font-weight: 500;
  backdrop-filter: blur(4px);
}

.banner-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.banner-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.banner-btn {
  display: inline-block;
  font-size: 22rpx;
  color: #F5A623;
  background: #fff;
  padding: 8rpx 28rpx;
  border-radius: 24rpx;
  font-weight: 600;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.banner-btn:active {
  transform: scale(0.95);
}

.banner-emoji {
  font-size: min(100rpx, 13vw);
  opacity: 0.85;
  margin-left: 16rpx;
  flex-shrink: 0;
  animation: pulse 3s ease-in-out infinite;
}

/* ========== 入口卡片 ========== */
.entry-section {
  display: flex;
  gap: 20rpx;
  padding: 28rpx 4% 0;
  animation: fadeInUp 0.6s ease-out;
}

.entry-card {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
  transition: transform 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.25s ease;
}

.entry-hover {
  transform: scale(0.96);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

.entry-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.entry-icon-pickup {
  background: linear-gradient(135deg, rgba(245, 166, 35, 0.15), rgba(255, 140, 66, 0.15));
}

.entry-icon-delivery {
  background: linear-gradient(135deg, rgba(76, 175, 80, 0.15), rgba(56, 142, 60, 0.15));
}

.entry-icon {
  font-size: 40rpx;
}

.entry-info {
  flex: 1;
  min-width: 0;
}

.entry-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-subtitle {
  font-size: 20rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-arrow {
  font-size: 32rpx;
  color: #ccc;
  font-weight: 300;
  flex-shrink: 0;
}

/* ========== 快捷入口 4 宫格 ========== */
.quick-section {
  display: flex;
  gap: 20rpx;
  padding: 28rpx 4% 0;
  flex-wrap: wrap;
  animation: fadeInUp 0.7s ease-out;
}

.quick-card {
  flex: 1;
  min-width: calc(25% - 20rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.25s ease;
}

.quick-card:active {
  transform: scale(0.94);
}

.quick-emoji {
  font-size: min(56rpx, 7.5vw);
  margin-bottom: 12rpx;
}

.quick-label {
  font-size: 22rpx;
  color: #666;
  font-weight: 500;
  white-space: nowrap;
}

/* ========== 底部留白 ========== */
.bottom-spacer {
  height: calc(120rpx + env(safe-area-inset-bottom));
}
