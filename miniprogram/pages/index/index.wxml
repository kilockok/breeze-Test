<!--index.wxml-->
<view class="page">
  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar-inner" style="height: {{navBarHeight}}px;">
      <view class="nav-location" bindtap="goPickup">
        <text class="nav-location-icon">📍</text>
        <text class="nav-location-text">万达广场店</text>
        <text class="nav-arrow">›</text>
      </view>
      <view class="nav-brand">清凤时光</view>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <!-- 占位 -->
  <view style="height: {{statusBarHeight + navBarHeight}}px;"></view>

  <scroll-view class="scroll-area" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- Hi 用户名 问候 -->
    <view class="greeting-section">
      <view class="greeting-row">
        <text class="greeting-text" wx:if="{{isLoggedIn}}">Hi, {{nickName}} 👋</text>
        <text class="greeting-text" wx:else>Hi, 欢迎来到清凤时光 ☕</text>
      </view>
      <text class="greeting-sub">今天想喝点什么？</text>
    </view>

    <!-- Banner 轮播 -->
    <view class="banner-section">
      <swiper
        class="banner-swiper"
        indicator-dots
        indicator-color="rgba(255,255,255,0.4)"
        indicator-active-color="#FFFFFF"
        autoplay
        circular
        interval="{{3500}}"
        duration="{{500}}"
        current="{{currentBanner}}"
        bindchange="onBannerChange"
      >
        <swiper-item wx:for="{{banners}}" wx:key="id">
          <view class="banner-card banner-card-{{index}}">
            <view class="banner-content">
              <view class="banner-tag">{{index === 0 ? '新品' : index === 1 ? '优惠' : '会员'}}</view>
              <view class="banner-title">{{item.title}}</view>
              <view class="banner-subtitle">{{index === 0 ? '春日限定 清新上线' : index === 1 ? '邀好友一起喝奶茶' : '每周三 专属福利'}}</view>
              <view class="banner-btn">立即查看</view>
            </view>
            <view class="banner-emoji">{{index === 0 ? '🌸' : index === 1 ? '🧋' : '🎉'}}</view>
          </view>
        </swiper-item>
      </swiper>
    </view>

    <!-- 入口卡片 -->
    <view class="entry-section">
      <view class="entry-card entry-pickup" bindtap="goPickup" hover-class="entry-hover">
        <view class="entry-icon-wrap entry-icon-pickup">
          <text class="entry-icon">🏠</text>
        </view>
        <view class="entry-info">
          <view class="entry-title">自取 Pick Up</view>
          <view class="entry-subtitle">到店取 · 免排队</view>
        </view>
        <text class="entry-arrow">›</text>
      </view>
      <view class="entry-card entry-delivery" bindtap="goDelivery" hover-class="entry-hover">
        <view class="entry-icon-wrap entry-icon-delivery">
          <text class="entry-icon">🛵</text>
        </view>
        <view class="entry-info">
          <view class="entry-title">外送 Delivery</view>
          <view class="entry-subtitle">送到家 · 最快30min</view>
        </view>
        <text class="entry-arrow">›</text>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="quick-section">
      <view class="quick-card" bindtap="goMenu" hover-class="entry-hover">
        <text class="quick-emoji">🧋</text>
        <text class="quick-label">全部菜单</text>
      </view>
      <view class="quick-card" bindtap="goPickup" hover-class="entry-hover">
        <text class="quick-emoji">🏪</text>
        <text class="quick-label">附近门店</text>
      </view>
      <view class="quick-card" bindtap="goMenu" hover-class="entry-hover">
        <text class="quick-emoji">🔥</text>
        <text class="quick-label">热门推荐</text>
      </view>
      <view class="quick-card" bindtap="goMenu" hover-class="entry-hover">
        <text class="quick-emoji">🌸</text>
        <text class="quick-label">季节限定</text>
      </view>
    </view>

    <!-- 底部留白 -->
    <view class="bottom-spacer"></view>
  </scroll-view>
</view>
