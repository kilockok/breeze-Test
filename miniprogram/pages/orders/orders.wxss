/* orders.wxss */

page {
  height: 100vh;
  background: var(--color-bg);
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* ========== Tab Bar ========== */
.tab-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  white-space: nowrap;
  background: #fff;
  display: flex;
  padding: 0 3%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  display: inline-block;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
  transition: color 0.25s ease;
}

.tab-item.active .tab-text {
  color: var(--color-primary);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--color-primary);
  animation: scaleIn 0.25s ease-out;
}

/* ========== Order List ========== */
.order-list {
  flex: 1;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.order-card {
  background: var(--color-card);
  border-radius: 24rpx;
  margin: 24rpx 4% 0;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(100, 70, 30, 0.06);
  animation: fadeInUp 0.35s ease-out;
  transition: transform 0.2s ease;
}

.order-card:active {
  transform: scale(0.98);
}

/* Card Header */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.store-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 65%;
}

.status {
  font-size: 26rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.status-pending {
  color: var(--color-primary);
}

.status-making {
  color: var(--color-blue);
}

.status-completed {
  color: var(--color-success);
}

/* Card Body */
.card-body {
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.item-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.item-name {
  font-size: 28rpx;
  color: #333;
  margin-right: 16rpx;
  flex-shrink: 0;
  max-width: 40%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-spec {
  font-size: 24rpx;
  color: #999;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-count {
  font-size: 26rpx;
  color: #666;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.item-more {
  padding-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

/* Card Footer */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  flex-wrap: wrap;
  gap: 12rpx;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.footer-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.total-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* Buttons */
.btn-reorder,
.btn-pay {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 28rpx;
  font-size: 24rpx;
  border-radius: 28rpx;
  line-height: 1;
  margin: 0;
  border: none;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.btn-reorder:active,
.btn-pay:active {
  transform: scale(0.95);
  opacity: 0.85;
}

.btn-reorder {
  background: var(--color-card);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.btn-reorder::after {
  border: none;
}

.btn-pay {
  background: var(--color-primary);
  color: #fff;
}

.btn-pay::after {
  border: none;
}

/* ========== Empty State ========== */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 200rpx;
  animation: fadeIn 0.5s ease-out;
}

.empty-state .ic {
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--color-text-secondary);
  margin-bottom: 32rpx;
}

.empty-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 48rpx;
  font-size: 28rpx;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: 40rpx;
  transition: transform 0.2s ease;
}

.empty-action:active {
  transform: scale(0.95);
  background: var(--color-primary-light);
}
