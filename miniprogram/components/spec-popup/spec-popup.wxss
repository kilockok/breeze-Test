/* ===== Overlay ===== */
.spec-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  animation: fadeIn 0.25s ease;
}

/* ===== Bottom Sheet ===== */
.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet.slide-up {
  transform: translateY(0);
}

.sheet-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 0 6%;
  max-height: calc(80vh - 180rpx);
  -webkit-overflow-scrolling: touch;
}

/* ===== Close button ===== */
.close-btn {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #999;
  z-index: 2;
  transition: transform 0.2s ease;
}

.close-btn:active {
  transform: scale(0.85) rotate(90deg);
}

/* ===== Product Header ===== */
.product-header {
  display: flex;
  align-items: center;
  padding: 32rpx 0 24rpx;
}

.product-image {
  width: min(160rpx, 22vw);
  height: min(160rpx, 22vw);
  border-radius: 16rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.product-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary, #E8913A);
}

/* ===== Divider ===== */
.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 8rpx 0;
}

/* ===== Spec Section ===== */
.spec-section {
  padding: 24rpx 0 8rpx;
}

.spec-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.chips-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
}

/* ===== Chips ===== */
.chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  margin: 8rpx 12rpx 8rpx 0;
  background: var(--color-bg);
  color: #666;
  border: 2rpx solid transparent;
  transition: all 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.chip:active {
  opacity: 0.8;
  transform: scale(0.95);
}

.chip-selected {
  background: var(--color-primary, #E8913A);
  color: #fff;
  border-color: var(--color-primary, #E8913A);
  box-shadow: 0 4rpx 12rpx rgba(232, 145, 58, 0.3);
}

.chip-topping-selected {
  background: var(--color-primary-light, #FFF5EB);
  color: var(--color-primary, #E8913A);
  border: 2rpx solid var(--color-primary, #E8913A);
}

/* ===== Quantity Section ===== */
.quantity-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
}

.quantity-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.quantity-controls {
  display: flex;
  align-items: center;
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  transition: all 0.2s ease;
}

.qty-btn:active {
  background: #e8e8e8;
  transform: scale(0.9);
}

.qty-btn-disabled {
  color: #ccc;
  background: #fafafa;
}

.qty-number {
  width: 72rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* ===== Bottom Bar ===== */
.bottom-bar {
  padding: 20rpx 6%;
  border-top: 1rpx solid #f0f0f0;
  background: #fff;
}

.total-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.total-label {
  font-size: 28rpx;
  color: #666;
}

.total-price {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary, #E8913A);
}

.add-cart-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: linear-gradient(135deg, var(--color-primary, #E8913A), var(--color-primary-dark, #D4792B));
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(232, 145, 58, 0.3);
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.add-cart-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}
