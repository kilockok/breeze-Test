.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: #2D2D2D;
  border-radius: 24rpx 24rpx 0 0;
  animation: slideUp 0.35s cubic-bezier(0.32, 0.72, 0, 1);
}

.cart-bar__inner {
  display: flex;
  align-items: center;
  height: 100rpx;
  padding: 0 4%;
}

/* Cart Icon */
.cart-bar__icon-wrap {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* Badge */
.cart-bar__badge {
  position: absolute;
  top: 0;
  right: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: var(--color-danger, #E74C3C);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  animation: bounceIn 0.4s ease-out;
}

.cart-bar__badge-text {
  font-size: 20rpx;
  color: #FFFFFF;
  line-height: 1;
  font-weight: bold;
}

/* Price */
.cart-bar__price-wrap {
  flex: 1;
  padding: 0 20rpx;
  overflow: hidden;
}

.cart-bar__price {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cart-bar__price--empty {
  font-size: 26rpx;
  font-weight: normal;
  color: #999999;
}

/* Checkout Button */
.cart-bar__checkout {
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 36rpx;
  background: var(--color-primary, #E8913A);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.cart-bar__checkout:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.cart-bar__checkout-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: bold;
  white-space: nowrap;
}

.cart-bar__checkout--disabled {
  background: #666666;
}

/* Empty State */
.cart-bar--empty {
  opacity: 0.5;
}

/* Safe Area Bottom */
.cart-bar__safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: #2D2D2D;
}
