<view class="cart-bar {{count <= 0 ? 'cart-bar--empty' : ''}}">
  <view class="cart-bar__inner">
    <!-- Cart Icon with Badge -->
    <view class="cart-bar__icon-wrap">
      <view class="ic ic-lg ic-cart ic--white"></view>
      <view class="cart-bar__badge" wx:if="{{count > 0}}">
        <text class="cart-bar__badge-text">{{count > 99 ? '99+' : count}}</text>
      </view>
    </view>

    <!-- Total Price -->
    <view class="cart-bar__price-wrap">
      <text class="cart-bar__price" wx:if="{{count > 0}}">¥{{totalText}}</text>
      <text class="cart-bar__price cart-bar__price--empty" wx:else>未选购商品</text>
    </view>

    <!-- Checkout Button -->
    <view
      class="cart-bar__checkout {{count <= 0 ? 'cart-bar__checkout--disabled' : ''}}"
      bindtap="goCheckout"
    >
      <text class="cart-bar__checkout-text">{{count > 0 ? '去结算' : '购物车是空的'}}</text>
    </view>
  </view>

  <!-- Safe Area Bottom -->
  <view class="cart-bar__safe-bottom"></view>
</view>
